[Desktop Entry]
Name=BertDesk
GenericName=Remote Desktop
Comment=Remote Desktop
Exec=bertdesk %u
Icon=bertdesk
Terminal=false
Type=Application
StartupNotify=true
Categories=Network;RemoteAccess;GTK;
Keywords=internet;linux;remote-control;remote-desktop;vnc;
Actions=new-window;
StartupWMClass=bertdesk

X-Desktop-File-Install-Version=0.23

[Desktop Action new-window]
Name=Open a New Window
Exec=bertdesk %u
